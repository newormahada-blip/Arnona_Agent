# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arnona pipeline — internal progress markers (not for repo)
reports/__PROGRESS__*
__pycache__/

# Excel-parsing Web Worker, bundled by `npm run build:worker` (runs before dev/build)
/public/workers/

# Municipal data — kept in the private Supabase bucket (scripts/private_data.py),
# never in this public repo
/reports/*.xlsx
/scripts/data/archive/
# scripts/data/arnona_data.xlsx stays until the scan routine reads it from the bucket
/public/arnona_lookup.json
/tools/neighborhoods/data/address_cache.csv
/tools/neighborhoods/data/geocode_cache.jsonl
